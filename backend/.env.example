# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=livestock_db

# MongoDB
MONGO_URI=mongodb://localhost:27017/livestock_logs

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Frontend URL
CLIENT_URL=http://localhost:3000
